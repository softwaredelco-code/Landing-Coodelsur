generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "debian-openssl-1.1.x"]
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum LeadEstado {
  incompleto           // Incompleta
  completo             // Completa
  por_contactar        // Por Contactar
  no_interesado        // No interesado
  aprobado             // Aprobado
  desembolsado         // Desembolsado
  rechazado_reportado  // Rechazado: Reportado
  rechazado_no_cumple  // Rechazado: No cumple requisitos
  recibido             // Legacy
  revisado             // Legacy
  contactado           // Legacy
  descartado           // Legacy
}

/// Solicitud de crédito (Microcrédito Small y futuros productos).
model Lead {
  id                       String     @id @default(uuid())
  tipoCredito              String     // ej. microcredito_small
  nombre                   String
  cedula                   String
  telefono                 String
  email                    String?
  /// Monto en COP — desnormalizado para listados admin
  capitalSolicitado        Int?
  /// 0–100 — progreso del formulario incompleto
  progresoFormulario       Int?
  pasoActualFormulario     String?
  /// Payload completo del formulario + metadata de adjuntos (paths, no binarios)
  datosFormulario          Json
  origen                   String     // web, witme, etc.
  estado                   LeadEstado @default(completo)
  aceptaTerminos           Boolean    @default(false)
  fechaAceptacionTerminos  DateTime?
  utmSource                String?
  utmCampaign              String?
  utmMedium                String?
  utmTerm                  String?
  utmContent               String?
  ip                       String?
  ciudad                   String?
  pais                     String?
  latitud                  Float?
  longitud                 Float?
  fechaCreacion            DateTime   @default(now())
  fechaActualizacion       DateTime   @updatedAt

  @@index([tipoCredito])
  @@index([origen])
  @@index([estado])
  @@index([cedula])
  @@index([fechaCreacion])
  @@index([utmSource])
}

/// Parámetros de amortización por producto (editables desde el panel admin).
model CreditoParametros {
  tipoCredito             String   @id
  nombreVisible           String
  tasaMensual             Float
  estudioCreditoModo      String   // fijo | porcentaje
  estudioCreditoValor     Float
  fianzaMensualPorcentaje Float
  vidaDeudoresPorcentaje  Float
  plazosPermitidos        Int[]
  activo                  Boolean  @default(true)
  fechaActualizacion      DateTime @updatedAt
}
