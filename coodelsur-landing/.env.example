# --- Base de datos Supabase (OBLIGATORIO) ---
# Transaction pooler — puerto 6543 — ?pgbouncer=true
DATABASE_URL="postgresql://coodelsur:coodelsur@localhost:5432/coodelsur?schema=public"

# Session pooler — puerto 5432 — para npm run db:push
DIRECT_URL="PEGAR_DIRECT_URL"

# --- Supabase Storage — adjuntos cédula, video, firma (OBLIGATORIO) ---
SUPABASE_URL="PEGAR_SUPABASE_URL"
SUPABASE_SERVICE_ROLE_KEY="PEGAR_SUPABASE_SERVICE_ROLE_KEY"
SUPABASE_STORAGE_BUCKET="lead-attachments"

# --- Panel admin (OBLIGATORIO) ---
ADMIN_PASSWORD="PEGAR_ADMIN_PASSWORD"

# --- App (OBLIGATORIO en desarrollo real) ---
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
NEXT_PUBLIC_DEMO_MODE="false"

# --- Opcional: no usar JSON local; dejar vacío = PostgreSQL ---
LEAD_STORE=""

# --- Webhook Witme (opcional en dev) ---
WITME_API_KEY="change-me-witme-key"

# --- Anti-duplicados cédula (opcional) ---
DUPLICATE_CEDULA_DAYS="30"

