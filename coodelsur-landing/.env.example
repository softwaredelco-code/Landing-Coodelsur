# Base de datos PostgreSQL
# Local (Docker): postgresql://coodelsur:coodelsur@localhost:5432/coodelsur?schema=public
# Producción (Supabase): Project Settings → Database → Connection string (URI)
DATABASE_URL="postgresql://coodelsur:coodelsur@localhost:5432/coodelsur?schema=public"

# Webhook Witme — Authorization: Bearer <token>
WITME_API_KEY="change-me-witme-key"

# Geolocalización por IP (opcional)
# IPAPI_KEY=""

# Supabase Storage (cédula, video, firma)
# Project Settings → API → Project URL y service_role key
SUPABASE_URL=""
SUPABASE_SERVICE_ROLE_KEY=""
SUPABASE_STORAGE_BUCKET="lead-attachments"

LEAD_STORE=""
# file = forzar data/leads.json | vacío = PostgreSQL con fallback automático

# Panel admin (/admin)
ADMIN_PASSWORD="change-me-admin"

# URL pública del sitio
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# false = envía al backend real
NEXT_PUBLIC_DEMO_MODE="false"
