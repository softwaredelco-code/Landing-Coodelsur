# Base de datos PostgreSQL
# Local (Docker): postgresql://coodelsur:coodelsur@localhost:5432/coodelsur?schema=public
# Producción (Supabase): Project Settings → Database → Connection string (URI)
DATABASE_URL="postgresql://coodelsur:coodelsur@localhost:5432/coodelsur?schema=public"
# Supabase: Session pooler (puerto 5432) — solo migraciones Prisma (db:push)
# DIRECT_URL="postgresql://postgres.<ref>:<password>@aws-0-sa-east-1.pooler.supabase.com:5432/postgres"

# Webhook Witme — Authorization: Bearer <token>
WITME_API_KEY="change-me-witme-key"

# Geolocalización por IP (opcional)
# IPAPI_KEY=""

# Supabase Storage (cédula, video, firma)
# Project Settings → API → Project URL y service_role key
SUPABASE_URL=""
SUPABASE_SERVICE_ROLE_KEY=""
SUPABASE_STORAGE_BUCKET="lead-attachments"

LEAD_STORE=""
# file = forzar data/leads.json | vacío = PostgreSQL con fallback automático

# Panel admin (/admin)
ADMIN_PASSWORD="change-me-admin"

# URL pública del sitio
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# false = envía al backend real
NEXT_PUBLIC_DEMO_MODE="false"

# --- Correo al usuario (elige SMTP recomendado o Resend) ---

# Opción A — SMTP Brevo (gratis ~300/día, envía a Gmail/Outlook/Yahoo)
# 1) brevo.com → remitente → verifica cartera@coodelsursas.com.co (solo clic en correo, sin DNS)
# 2) SMTP & API → genera clave SMTP
# SMTP_HOST="smtp-relay.brevo.com"
# SMTP_PORT="587"
# SMTP_USER="tu-login-de-brevo@email.com"
# SMTP_PASS="clave-smtp-de-brevo"
# EMAIL_FROM="Coodelsur <cartera@coodelsursas.com.co>"

# Opción B — SMTP Gmail (App Password, ~500/día)
# SMTP_HOST="smtp.gmail.com"
# SMTP_PORT="587"
# SMTP_USER="tu@gmail.com"
# SMTP_PASS="contraseña-de-aplicacion"
# EMAIL_FROM="Coodelsur <tu@gmail.com>"

# Opción C — Resend (requiere dominio verificado para enviar a terceros)
# RESEND_API_KEY="re_..."
# EMAIL_FROM="Coodelsur <solicitudes@tudominio.com.co>"

# Verificación cédula CC vía Registraduría (proveedor Verifik — opcional de pago)
# VERIFIK_API_KEY=""

# Ventana para bloquear solicitudes duplicadas con la misma cédula (días)
DUPLICATE_CEDULA_DAYS="30"
